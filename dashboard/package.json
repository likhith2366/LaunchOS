{
  "name": "launchos-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Operator view for LaunchOS: inventory, queue depth, admission rate and checkout health.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
